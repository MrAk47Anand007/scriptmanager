generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Script {
  id              String      @id @default(uuid())
  name            String      @unique
  filename        String
  description     String      @default("")
  language        String      @default("python")
  interpreter     String?
  webhookToken    String?     @unique @map("webhook_token")
  webhookSecret   String?     @map("webhook_secret")
  requireWebhookSignature Boolean @default(false) @map("require_webhook_signature")
  scheduleCron    String?     @map("schedule_cron")
  scheduleEnabled Boolean     @default(false) @map("schedule_enabled")
  parameters      String      @default("[]")
  gistId          String?     @map("gist_id")
  gistUrl         String?     @map("gist_url")
  syncToGist      Boolean     @default(false) @map("sync_to_gist")
  gistFilename    String?     @map("gist_filename")
  collectionId    String?     @map("collection_id")
  timeoutMs       Int?        @map("timeout_ms")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  lastRun         DateTime?   @map("last_run")

  collection      Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  builds          Build[]
  tags            ScriptTag[]
  envVars         ScriptEnvVar[]
  versions        ScriptVersion[]

  @@map("scripts")
}

model Tag {
  id        String      @id @default(uuid())
  name      String      @unique
  color     String      @default("#6366f1")
  createdAt DateTime    @default(now()) @map("created_at")

  scripts   ScriptTag[]

  @@map("tags")
}

model ScriptTag {
  scriptId  String  @map("script_id")
  tagId     String  @map("tag_id")

  script    Script  @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([scriptId, tagId])
  @@map("script_tags")
}

model ScriptEnvVar {
  id        String  @id @default(uuid())
  scriptId  String  @map("script_id")
  key       String
  value     String  @default("")
  isSecret  Boolean @default(false) @map("is_secret")

  script    Script  @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@unique([scriptId, key])
  @@map("script_env_vars")
}

model ScriptVersion {
  id             String   @id @default(uuid())
  scriptId       String   @map("script_id")
  content        String
  snapshotNumber Int      @map("snapshot_number")
  savedAt        DateTime @default(now()) @map("saved_at")

  script         Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@map("script_versions")
}

model Build {
  id              String    @id @default(uuid())
  scriptId        String    @map("script_id")
  status          String    @default("pending")
  triggeredBy     String    @default("manual") @map("triggered_by")
  logFile         String?   @map("log_file")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  exitCode        Int?      @map("exit_code")
  webhookPayload  String?   @map("webhook_payload")
  createdAt       DateTime  @default(now()) @map("created_at")

  script          Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@map("builds")
}

model Collection {
  id          String    @id @default(uuid())
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now()) @map("created_at")
  projectId   String?   @map("project_id")

  scripts     Script[]
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("collections")
}

model Project {
  id          String       @id @default(uuid())
  name        String
  description String       @default("")
  environment String       @default("development")
  color       String       @default("#6366f1")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  collections    Collection[]
  serverProfiles ServerProfile[]

  @@map("projects")
}

model ServerProfile {
  id              String   @id @default(uuid())
  name            String
  host            String
  port            Int      @default(22)
  username        String
  authMethod      String   @default("password") @map("auth_method")
  encryptedSecret String?  @map("encrypted_secret")
  keyPath         String?  @map("key_path")
  projectId       String?  @map("project_id")
  notes           String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  remoteExecutions RemoteExecution[]

  @@map("server_profiles")
}

model RemoteExecution {
  id          String    @id @default(uuid())
  scriptId    String    @map("script_id")
  profileId   String    @map("profile_id")
  scriptName  String    @map("script_name")
  profileName String    @map("profile_name")
  serverHost  String    @map("server_host")
  status      String    @default("pending_approval")
  triggeredBy String    @default("manual") @map("triggered_by")
  approvedBy  String?   @map("approved_by")
  remotePath  String?   @map("remote_path")
  exitCode    Int?      @map("exit_code")
  logOutput   String?   @map("log_output")
  paramValues String    @default("{}") @map("param_values")
  requestedAt DateTime  @default(now()) @map("requested_at")
  approvedAt  DateTime? @map("approved_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  profile     ServerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("remote_executions")
}

model Setting {
  key       String    @id
  value     String?
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("settings")
}

model ScriptTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  category    String   @default("general")
  language    String   @default("python")
  interpreter String?
  content     String
  parameters  String   @default("[]")
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("script_templates")
}
