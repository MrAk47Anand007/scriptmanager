{
  "name": "scriptmanager",
  "version": "1.0.0",
  "private": true,
  "description": "A standalone self-hosted script manager - write, run, schedule, and organize scripts",
  "main": "dist-electron/electron/bootstrap.js",
  "bin": {
    "sm": "./cli/sm.mjs"
  },
  "scripts": {
    "dev": "node ./scripts/dev-server.mjs",
    "build": "npx prisma generate && next build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/unit/releaseHttpSecurity.test.ts tests/unit/releaseCompatibility.test.ts tests/unit/releaseRecovery.test.ts tests/unit/agentAccessPolicy.test.ts tests/unit/authorizationMatrix.test.ts tests/unit/pluginHost.test.ts tests/unit/secretStore.test.ts",
    "test:accessibility": "vitest run tests/unit/accessibilityRelease.test.ts",
    "test:performance": "vitest run tests/performance",
    "test:acceptance": "vitest run tests/integration/releaseAcceptance.test.ts",
    "plugin:create": "node ./scripts/create-scriptmanager-plugin.mjs",
    "release:backup": "node ./scripts/release-data.mjs backup",
    "release:restore": "node ./scripts/release-data.mjs restore",
    "release:preflight": "node ./scripts/release-preflight.mjs",
    "start": "NODE_ENV=production ts-node -r tsconfig-paths/register --project tsconfig.server.json server.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset:clean": "node ./scripts/reset-workspace-db.mjs",
    "db:reset:clean:files": "node ./scripts/reset-workspace-db.mjs --wipe-workspace --wipe-builds",
    "workspace:reset:fresh": "node ./scripts/reset-workspace-db.mjs --wipe-workspace --wipe-builds --workspace-root ./ScriptsSaved",
    "next:dev": "next dev",
    "cli": "node ./cli/sm.mjs",
    "electron:dev": "npx tsc -p electron/tsconfig.json && cross-env DESKTOP_AUTH_SECRET=dev-desktop-secret-local concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npx prisma generate && cross-env ELECTRON_BUILD=1 next build && tsc -p electron/tsconfig.json && electron-builder",
    "electron:pack": "npx prisma generate && cross-env ELECTRON_BUILD=1 next build && tsc -p electron/tsconfig.json && electron-builder --dir"
  },
  "build": {
    "appId": "com.scriptmanager.app",
    "productName": "ScriptManager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      ".next/**",
      "node_modules/**",
      "prisma/schema.prisma",
      "prisma/migrations/**",
      "public/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma"
      },
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@prisma/client",
        "to": "node_modules/@prisma/client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "ScriptManager-${version}-${arch}-setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "ScriptManager-${version}-${arch}.${ext}",
      "hardenedRuntime": true
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "ScriptManager-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@reduxjs/toolkit": "^2.2.1",
    "@tanstack/react-virtual": "^3.13.23",
    "@xterm/addon-webgl": "^0.19.0",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^9.0.0",
    "ioredis": "^5.9.3",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.1.0",
    "react-resizable-panels": "^4.6.5",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.5",
    "webdav": "^5.10.0",
    "ws": "^8.19.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.11",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "prisma": "6.19.2",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.4"
  }
}
